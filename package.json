{
  "name": "nanogpt-provider-vscode-extension",
  "displayName": "NanoGPT Provider for VS Code",
  "description": "Bring NanoGPT models to VS Code and Copilot Chat as a language model provider.",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/deadronos/nanogpt-provider-vscode-extension"
  },
  "author": {"name": "deadronos"},
  "readme": "README.md",
  "publisher": "deadronos",
  "license": "MIT",
  "homepage": "https://github.com/deadronos/nanogpt-provider-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/deadronos/nanogpt-provider-vscode-extension/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "nanogpt",
        "displayName": "NanoGPT",
        "configuration": {
          "type": "object",
          "required": [
            "apiKey"
          ],
          "properties": {
            "apiKey": {
              "type": "string",
              "secret": true,
              "markdownDescription": "NanoGPT API key."
            },
            "routingMode": {
              "type": "string",
              "enum": [
                "subscription",
                "paygo"
              ],
              "enumItemLabels": [
                "Subscription",
                "Pay as you go"
              ],
              "default": "subscription",
              "description": "NanoGPT routing surface for chat completions."
            },
            "provider": {
              "type": "string",
              "default": "",
              "description": "Optional upstream provider id sent as X-Provider when routingMode is paygo."
            },
            "reasoningEffort": {
              "type": "string",
              "enum": [
                "auto",
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "enumItemLabels": [
                "Auto",
                "None",
                "Minimal",
                "Low",
                "Medium",
                "High",
                "Extra High"
              ],
              "default": "auto",
              "group": "navigation",
              "description": "Optional reasoning effort sent to reasoning-capable models."
            },
            "reasoningOutput": {
              "type": "string",
              "enum": [
                "native",
                "hidden",
                "visible"
              ],
              "enumItemLabels": [
                "Native",
                "Hidden",
                "Visible fallback"
              ],
              "default": "native",
              "description": "Controls how streamed reasoning is surfaced. Native uses VS Code's thinking part when available; visible falls back to normal text."
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "nanogpt.manage",
        "title": "NanoGPT: Manage API Key"
      },
      {
        "command": "nanogpt.refreshModels",
        "title": "NanoGPT: Refresh Models"
      }
    ],
    "configuration": {
      "title": "NanoGPT",
      "properties": {
        "nanogpt.apiKey": {
          "type": "string",
          "default": "",
          "secret": true,
          "markdownDescription": "NanoGPT API key. Prefer the `NanoGPT: Manage API Key` command because settings can be synced or committed by accident."
        },
        "nanogpt.routingMode": {
          "type": "string",
          "enum": [
            "subscription",
            "paygo"
          ],
          "default": "subscription",
          "description": "NanoGPT routing surface for chat completions."
        },
        "nanogpt.provider": {
          "type": "string",
          "default": "",
          "description": "Optional upstream provider id sent as X-Provider when routingMode is paygo."
        },
        "nanogpt.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional allowlist of NanoGPT model ids. Leave empty to discover models from NanoGPT."
        },
        "nanogpt.reasoningEffort": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "auto",
          "description": "Optional reasoning effort sent to reasoning-capable models."
        },
        "nanogpt.reasoningOutput": {
          "type": "string",
          "enum": [
            "native",
            "hidden",
            "visible"
          ],
          "default": "native",
          "description": "Controls how streamed reasoning is surfaced. Native uses VS Code's thinking part when available; visible falls back to normal text."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
